# Application
NODE_ENV=development
PORT=3000
APP_NAME=Bridgelet SDK

# Swagger UI (/api/docs) — disabled by default in production. Set to 'true' to expose it.
# Never enable in production unless the endpoint is behind authentication.
ENABLE_SWAGGER=false

# CORS — comma-separated list of allowed origins. In production, NEVER use '*'.
# Example: CORS_ORIGINS=https://app.bridgelet.io,https://admin.bridgelet.io
CORS_ORIGINS=https://app.bridgelet.io

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=bridgelet
DATABASE_USER=bridgelet_user
DATABASE_PASSWORD=bridgelet_pass
DATABASE_SYNC=false
DATABASE_LOGGING=true

# Stellar
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Horizon fallback URL — used when the primary Horizon is unreachable.
# For testnet the SDF public Horizon is used as fallback automatically.
STELLAR_HORIZON_FALLBACK_URL=

# Stellar Accounts
FUNDING_ACCOUNT_SECRET=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
RECOVERY_ACCOUNT_PUBLIC=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Smart Contracts
EPHEMERAL_ACCOUNT_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
STELLAR_SWEEP_CONTROLLER_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# 32-byte Ed25519 seed for sweep authorization signing (hex-encoded)
# The corresponding public key must be registered in SweepController as authorized_signer
# Generated with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SWEEP_SIGNING_KEY_SEED=f76f684a3a8b64f32a7dc7eba0b0a5040ba66b5ea67dad348c3b69b79db3339c

# Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
CLAIM_TOKEN_EXPIRY=2592000

# 32-byte hex-encoded key — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-char-hex-string

# API
API_RATE_LIMIT=100

# Payment Monitor — how often to poll Horizon for inbound payments (ms)
PAYMENT_POLL_INTERVAL_MS=30000

# Webhooks
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_TIMEOUT=5000

# Scheduler
EXPIRY_CHECK_INTERVAL_MS=300000        # 5 minutes
INITIALIZING_TIMEOUT_MS=600000         # 10 minutes — stale INITIALIZING accounts marked FAILED after this
INITIALIZING_CLEANUP_INTERVAL_MS=900000 # 15 minutes

# Logging
LOG_LEVEL=debug
